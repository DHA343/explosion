[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_nemol"]
input_name = "vertex"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_noise_coordinates"]
size = Vector2(620, 500)
expression = "vec3 p = fragment_position - center_position;
float along = dot(p, view_direction);
vec3 radial = p - view_direction * along;

vec2 uv = radial.xy / (sphere_radius * 2.0) + vec2(0.5);
vec2 scaled_uv = (uv - vec2(0.5)) * noise_scale + vec2(0.5);

noise_coord = vec3(
	scaled_uv,
	time * noise_speed
);"

[sub_resource type="VisualShaderNodeVectorDecompose" id="VisualShaderNodeVectorDecompose_noise"]

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_glow_profile"]
size = Vector2(640, 520)
expression = "float core_radius = max(
	sphere_radius * core_ratio,
	0.0001
);
float signed_noise = noise * 2.0 - 1.0;
float radius_scale = max(
	1.0 + signed_noise * distortion_strength,
	0.05
);
float distorted_radius = core_radius * radius_scale;
float normalized_distance = radial_distance / distorted_radius;
float g = exp(-(normalized_distance * normalized_distance));

emission = vec3(g * intensity);
alpha = g;"

