[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_xp8tk"]
linked_parent_graph_frame = 107
size = Vector2(920, 639.99994)
expression = "float x = clamp(rim_ratio, 0.0, 1.0);
float t1 = clamp(min(inner_boundary, outer_boundary), 0.0, 1.0);
float t2 = clamp(max(inner_boundary, outer_boundary), 0.0, 1.0);

float max_h = min(min(t1, 1.0 - t2), (t2 - t1) * 0.5);
float h = min(max(softness, 0.0) * 0.5, max_h);

float a = h > 0.00001 ? smoothstep(t1 - h, t1 + h, x) : step(t1, x);
float b = h > 0.00001 ? smoothstep(t2 - h, t2 + h, x) : step(t2, x);

inner_band_mask = 1.0 - a;
chromatic_band_mask = a - b;
outer_band_mask = b;"

