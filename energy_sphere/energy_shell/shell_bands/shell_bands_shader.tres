[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_boundaries"]
size = Vector2(660, 620)
linked_parent_graph_frame = 2
expression = "inner_transition_start = clamp(inner_band_width, 0.0, 1.0);
float safe_softness = max(band_softness, 0.0001);
inner_transition_end = inner_transition_start + safe_softness;

float requested_outer_start = clamp(
	inner_band_width + chromatic_band_width,
	0.0,
	1.0
);
outer_transition_start = max(requested_outer_start, inner_transition_end);
outer_transition_end = outer_transition_start + safe_softness;"

