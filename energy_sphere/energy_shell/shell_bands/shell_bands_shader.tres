[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_u0rc8"]
size = Vector2(779.99994, 900)
expression = "float inner_alpha = inner_band_mask * inner_band_opacity;
float chromatic_alpha = chromatic_band_mask * chromatic_band_opacity;
float outer_alpha = outer_band_mask * outer_band_opacity;

alpha = clamp(inner_alpha + chromatic_alpha + outer_alpha, 0.0, 1.0);

vec3 premultiplied = inner_band_color * inner_alpha
	+ chromatic_band_emission * chromatic_alpha
	+ outer_band_color * outer_alpha;

emission = premultiplied / max(alpha, 0.0001);"

