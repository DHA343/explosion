[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_nemol"]
parameter_name = "core_size"
hint = 2
max = 0.5
step = 0.01
default_value_enabled = true
default_value = 0.3

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_7o0jg"]
size = Vector2(780, 1280)
expression = "const int STEPS = 128;
const float STEP_SIZE = 0.03;

vec3 p = ray_position + ray_direction * 0.001;
float light_sum = 0.0;

for (int i = 0; i < STEPS; i++) {
	if (max(max(abs(p.x), abs(p.y)), abs(p.z)) > 1.001) {
		break;
	}

	float d2 = dot(p, p);
	float density = exp(-d2 / (core_size * core_size));

	light_sum += density * STEP_SIZE;
	p += ray_direction * STEP_SIZE;
}

float brightness = light_sum * intensity;

ray_color = vec3(brightness);
ray_alpha = clamp(brightness, 0.0, 1.0);"

