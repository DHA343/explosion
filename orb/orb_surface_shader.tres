[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_hvpmf"]
linked_parent_graph_frame = 102
size = Vector2(700, 700)
expression = "float inner_layer_alpha = inner_mask * inner_alpha;
float base_alpha = max(rim_mask, inner_layer_alpha);
vec3 base_color = mix(inner_color.rgb, rim_color.rgb, rim_mask);
float surface_layer_alpha = surface_mask * surface_alpha;
float final_alpha = surface_layer_alpha + base_alpha * (1.0 - surface_layer_alpha);
vec3 final_color = vec3(0.0);

if (final_alpha > 0.0001) {
	final_color = (surface_color.rgb * surface_layer_alpha + base_color * base_alpha * (1.0 - surface_layer_alpha)) / final_alpha;
}

albedo = final_color;
alpha = final_alpha;"

