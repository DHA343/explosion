[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_layer_masks"]
linked_parent_graph_frame = 101
size = Vector2(500, 500)
expression = "float safe_rim_softness = max(rim_softness, 0.0001);
float rim_end = min(rim_start + safe_rim_softness, 1.0);

rim_mask = smoothstep(rim_start, rim_end, fresnel);

float band_lo = min(inner_band_start, inner_band_end);
float band_hi = max(inner_band_start, inner_band_end);
float band_width = max(band_hi - band_lo, 0.0002);
float safe_band_softness = min(max(inner_band_softness, 0.0001), band_width * 0.5);

float band_enter = smoothstep(band_lo, band_lo + safe_band_softness, fresnel);
float band_exit = 1.0 - smoothstep(band_hi - safe_band_softness, band_hi, fresnel);

inner_mask = band_enter * band_exit * (1.0 - rim_mask);"

