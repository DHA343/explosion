[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_layer_masks"]
linked_parent_graph_frame = 101
size = Vector2(500, 500)
expression = "float safe_rim_softness = max(rim_softness, 0.0001);
float rim_end = min(rim_start + safe_rim_softness, 1.0);

rim_mask = smoothstep(rim_start, rim_end, fresnel);

float centered_noise = clamp(noise_value, 0.0, 1.0) * 2.0 - 1.0;
float disturbed_start = inner_band_start + centered_noise * noise_strength;
disturbed_start = clamp(disturbed_start, 0.0, rim_start - 0.001);

float inner_outer_end = min(rim_end + max(rim_overlap, 0.0), 1.0);
float available_width = max(inner_outer_end - disturbed_start, 0.0002);
float safe_inner_softness = min(max(inner_band_softness, 0.0001), available_width * 0.5);

float band_enter = smoothstep(disturbed_start, disturbed_start + safe_inner_softness, fresnel);
float band_exit = 1.0 - smoothstep(inner_outer_end - safe_inner_softness, inner_outer_end, fresnel);

inner_mask = band_enter * band_exit;"

