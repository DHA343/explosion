[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_7y1g6"]
linked_parent_graph_frame = 102
expression = "float inner_layer_alpha = inner_mask * inner_alpha;
float shell_alpha = max(rim_mask, inner_layer_alpha);
vec3 shell_color = mix(inner_color.rgb, rim_color.rgb, rim_mask);

albedo = shell_color;
alpha = shell_alpha;"

