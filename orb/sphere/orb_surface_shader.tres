[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_layer_masks"]
linked_parent_graph_frame = 101
size = Vector2(664, 1040)
expression = "float centered_noise = clamp(noise_value, 0.0, 1.0) * 2.0 - 1.0;

float safe_rim_softness = max(rim_softness, 0.0001);

float max_rim_start = max(1.0 - safe_rim_softness, 0.0);
float disturbed_rim_start = clamp(rim_start + centered_noise * rim_noise_strength, 0.0, max_rim_start);
float disturbed_rim_end = disturbed_rim_start + safe_rim_softness;

rim_mask = smoothstep(disturbed_rim_start, disturbed_rim_end, fresnel);

float disturbed_inner_start = inner_band_start + centered_noise * noise_strength;
disturbed_inner_start = clamp(disturbed_inner_start, 0.0, disturbed_rim_start - 0.001);

float inner_outer_end = min(disturbed_rim_end + max(rim_overlap, 0.0), 1.0);
float available_width = max(inner_outer_end - disturbed_inner_start, 0.0002);
float safe_inner_softness = min(max(inner_band_softness, 0.0001), available_width * 0.5);

float band_enter = smoothstep(disturbed_inner_start, disturbed_inner_start + safe_inner_softness, fresnel);
float band_exit = 1.0 - smoothstep(inner_outer_end - safe_inner_softness, inner_outer_end, fresnel);

inner_mask = band_enter * band_exit;"

