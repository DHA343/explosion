nodes/fragment/127/expression = "float centered_x = clamp(noise_x, 0.0, 1.0) - 0.5;
float centered_y = clamp(noise_y, 0.0, 1.0) - 0.5;
float centered_z = clamp(noise_z, 0.0, 1.0) - 0.5;

float centered_blend = centered_x * weights.x + centered_y * weights.y + centered_z * weights.z;

float blend_energy = sqrt(max(dot(weights, weights), 0.0001));
centered_blend /= blend_energy;

surface_noise_value = clamp(centered_blend + 0.5, 0.0, 1.0);"
