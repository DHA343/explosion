[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_noise_coordinates"]
linked_parent_graph_frame = 103
size = Vector2(680, 1000)
expression = "vec3 direction = noise_direction;

if (length(direction) < 0.0001) {
	direction = vec3(0.0, 1.0, 0.0);
} else {
	direction = normalize(direction);
}

boundary_noise_position =
	local_position * noise_scale
	+ vec3(0.5)
	+ direction * time * noise_speed;

vec3 local_normal = local_position;

if (length(local_normal) < 0.0001) {
	local_normal = vec3(0.0, 1.0, 0.0);
} else {
	local_normal = normalize(local_normal);
}

float sign_x = local_normal.x < 0.0 ? -1.0 : 1.0;
float sign_y = local_normal.y < 0.0 ? -1.0 : 1.0;
float sign_z = local_normal.z < 0.0 ? -1.0 : 1.0;

vec2 uv_x = vec2(local_position.y * sign_x, local_position.z) * surface_noise_scale + vec2(0.17, 0.53);
vec2 uv_y = vec2(local_position.x * sign_y, local_position.z) * surface_noise_scale + vec2(0.61, 0.11);
vec2 uv_z = vec2(local_position.x * sign_z, local_position.y) * surface_noise_scale + vec2(0.37, 0.79);

float surface_slice = time * surface_noise_speed + 0.31;

surface_coord_x = vec3(uv_x, surface_slice);
surface_coord_y = vec3(uv_y, surface_slice);
surface_coord_z = vec3(uv_z, surface_slice);

surface_weights = abs(local_normal);
surface_weights *= surface_weights;
surface_weights *= surface_weights;

float surface_weight_sum = max(surface_weights.x + surface_weights.y + surface_weights.z, 0.0001);
surface_weights /= surface_weight_sum;"

