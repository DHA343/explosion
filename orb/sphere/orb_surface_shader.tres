nodes/fragment/82/expression = "float half_softness = max(surface_noise_softness * 0.5, 0.0001);

float noise_mask = smoothstep(surface_noise_threshold - half_softness, surface_noise_threshold + half_softness, clamp(surface_noise_value, 0.0, 1.0));

surface_mask = clamp(surface_fresnel, 0.0, 1.0) * noise_mask * (1.0 - rim_mask);"
